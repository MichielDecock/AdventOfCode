import os
import math


def parse(filename):
    fullFilename = os.path.join(os.path.dirname(__file__), filename)
    with open(fullFilename) as file:
        lines = [line.strip('\n') for line in file]
        return (int(lines[0]), [int(x) for x in lines[1].split(',') if x != 'x'])
    return []


if __name__ == "__main__":
    eta, ids = parse('input')

    time, id = sorted([(math.ceil(eta / x) * x, x) for x in ids], key=lambda t: t[0])[0]
    print((time - eta) * id)