import os
import math


def parse(filename):
    fullFilename = os.path.join(os.path.dirname(__file__), filename)
    with open(fullFilename) as file:
        lines = [line.strip('\n') for line in file]
        return [(int(x), idx) for idx,x in enumerate(lines[1].split(',')) if x != 'x']
    return []

def findTimestamp(ids):
    t = 0
    delta = 1
    for id, offset in ids:
        while (t + offset) % id != 0:
            t += delta
        delta = math.lcm(delta, id)

    return t

if __name__ == "__main__":
    ids = parse('input')

    print(findTimestamp(ids))